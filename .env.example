# PayPal sandbox app keys from developer.paypal.com > Apps & Credentials.
# Leave empty to run in mock mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# OpenAI for rule parsing, risk notes and weekly summary. Leave empty to use the built in parser.
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-luna

# Channel3 product search (trychannel3.com). Leave empty to use a built in demo catalog.
CHANNEL3_API_KEY=

# Where the JSON data file lives. Default ./data
DATA_DIR=

# AG Studio trial licence key (from the AG Grid email)
AG_STUDIO_LICENSE=
# Optional list of OpenAI model ids for the Studio assistant picker
OPENAI_MODELS=gpt-5.6-luna
